{
  "functions": {
    "api/[...path].js": {
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/history/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
